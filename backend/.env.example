# ==========================================================================
# EMPntegral - Instagram -> WhatsApp lead automation
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file.
# ==========================================================================

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public HTTPS base URL of this server (used to build links inside alerts).
# In local development use an ngrok / cloudflared tunnel URL.
PUBLIC_BASE_URL=https://leads.example.com

# Password for the dashboard login screen. Pick something long.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Random secret used to sign the dashboard session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-random-64-hex-chars

# MongoDB connection string.
#   Atlas:       mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   self-hosted: mongodb://USER:PASSWORD@your-host:27017/?authSource=admin
#   local:       mongodb://127.0.0.1:27017
# On Atlas remember to allow your server's IP under Network Access, otherwise
# the connection times out at startup.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name inside the cluster. Indexes are created automatically on boot.
MONGODB_DB=empntegral

# Optional DNS resolver override, comma separated. Leave empty unless you need it.
# A "mongodb+srv://" URI requires an SRV lookup, and Node performs SRV lookups
# with its own bundled resolver instead of the operating system one. On some
# hosts that resolver cannot read the system DNS configuration and falls back to
# 127.0.0.1, where nothing is listening, so every lookup fails with
# "querySrv ECONNREFUSED" even though the machine's DNS works fine everywhere
# else. Setting this fixes it. Windows is the usual place this shows up.
DNS_SERVERS=

# IANA timezone used for scheduling and for displaying dates.
TIMEZONE=Asia/Jerusalem

# --------------------------------------------------------------------------
# Meta app (shared by Instagram and WhatsApp)
# --------------------------------------------------------------------------
# App Dashboard -> Settings -> Basic -> App Secret.
# Verifies the X-Hub-Signature-256 header on incoming WhatsApp webhooks.
META_APP_SECRET=

# Instagram API setup page -> "Instagram app secret". This is a DIFFERENT value
# from META_APP_SECRET above, and it is the one Instagram Login signs its
# webhooks with. Without it every Instagram webhook is rejected as "bad
# signature" even though the credentials are otherwise correct. Leave empty when
# INSTAGRAM_LOGIN_MODE=facebook_login, where META_APP_SECRET signs everything.
INSTAGRAM_APP_SECRET=

# A random string you invent. You type the SAME string into the Meta App
# Dashboard when you configure the webhook callback URL.
WEBHOOK_VERIFY_TOKEN=invent-a-random-verify-token

# Graph API version used for all outgoing calls.
GRAPH_API_VERSION=v23.0

# --------------------------------------------------------------------------
# Instagram Messaging
# --------------------------------------------------------------------------
# Which login flow your Meta app uses:
#   instagram_login = Instagram API with Instagram Login (graph.instagram.com,
#                     no Facebook Page required). This is the simpler path.
#   facebook_login  = Messenger API support for Instagram (graph.facebook.com,
#                     requires a Facebook Page linked to the IG account).
INSTAGRAM_LOGIN_MODE=instagram_login

# Long-lived access token.
#  - instagram_login mode: an Instagram User access token with the scopes
#    instagram_business_basic + instagram_business_manage_messages
#  - facebook_login mode: a Page access token with the permissions
#    instagram_basic + instagram_manage_messages + pages_manage_metadata
INSTAGRAM_ACCESS_TOKEN=

# instagram_login mode: your Instagram professional account ID.
# facebook_login mode: leave empty and fill FACEBOOK_PAGE_ID instead.
INSTAGRAM_ACCOUNT_ID=

# Only needed in facebook_login mode.
FACEBOOK_PAGE_ID=

# --------------------------------------------------------------------------
# WhatsApp Cloud API  --  DISABLED until you decide how to connect a number
# --------------------------------------------------------------------------
# Master gate. While false, the WhatsApp adapter performs NO network calls at
# all. It only records in the database what it would have sent, and the lead
# is parked in the "phone_received" status for you to handle by hand.
# Do not flip this to true until you have chosen one of:
#   (a) a separate, dedicated phone number for the API, or
#   (b) Coexistence (same number on app + API, requires Embedded Signup and a
#       Solution Partner / Tech Provider business designation), or
#   (c) a full migration of your existing number (destructive, irreversible).
WHATSAPP_ENABLED=false

# WhatsApp -> API Setup -> "Phone number ID" (a numeric ID, NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=

# System user access token with whatsapp_business_messaging +
# whatsapp_business_management. Prefer a permanent System User token.
WHATSAPP_ACCESS_TOKEN=

# Name of the APPROVED message template used for the very first WhatsApp
# message to a lead. The first message to a lead is always outside the 24h
# customer service window, so it must be a template.
WHATSAPP_TEMPLATE_NAME=

# Language code of that template, exactly as approved in the Meta dashboard.
WHATSAPP_TEMPLATE_LANGUAGE=he

# The category you DECLARED when submitting the template. Informational only.
# Meta assigns the final category at approval time and reports the actually
# billed category per message in the status webhook; that reported value is
# what gets stored. Cost is never assumed anywhere in the code.
# One of: marketing | utility | authentication | unknown
WHATSAPP_TEMPLATE_CATEGORY=unknown

# Default country calling code used to normalize local phone numbers
# (972 = Israel). "0501234567" becomes "+972501234567".
DEFAULT_COUNTRY_CODE=972

# --------------------------------------------------------------------------
# Telegram alerts (how the system notifies YOU)
# --------------------------------------------------------------------------
# Create a bot by messaging @BotFather on Telegram, then /newbot.
TELEGRAM_BOT_TOKEN=

# Your personal chat ID. Send any message to your new bot, then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------------------
# Automation behaviour
# --------------------------------------------------------------------------
# Master switch. Set to false to make the system receive and store messages
# without ever replying automatically.
AUTOMATION_ENABLED=true

# Minutes before a scheduled call that the reminder alert is sent.
CALL_REMINDER_MINUTES_BEFORE=10
